{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "src/**/*.test.ts",
    "src/app/hub-region-settings.ts"
  ]
}
