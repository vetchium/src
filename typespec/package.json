{
  "name": "typespec",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./admin/admin": "./admin/admin.ts",
    "./admin/auth/login": "./admin/auth/login.ts",
    "./admin/auth/password": "./admin/auth/password.ts",
    "./admin/auth/totp": "./admin/auth/totp.ts",
    "./admin/auth/types": "./admin/auth/types.ts",
    "./admin/authorization/management": "./admin/authorization/management.ts",
    "./admin/authorization/types": "./admin/authorization/types.ts",
    "./admin/hub-signup-domains/domains": "./admin/hub-signup-domains/domains.ts",
    "./admin/user/user": "./admin/user/user.ts",
    "./admin/users/invitations": "./admin/users/invitations.ts",
    "./admin/users/management": "./admin/users/management.ts",
    "./admin/users/profile": "./admin/users/profile.ts",
    "./admin/types": "./admin/types.ts",
    "./common/authentication": "./common/authentication.ts",
    "./common/common": "./common/common.ts",
    "./common/idempotency": "./common/idempotency.ts",
    "./common/localization": "./common/localization.ts",
    "./common/pagination": "./common/pagination.ts",
    "./common/security-effects": "./common/security-effects.ts",
    "./global-coordinator/global-coordinator": "./global-coordinator/global-coordinator.ts",
    "./hub/hub": "./hub/hub.ts",
    "./hub/auth/login": "./hub/auth/login.ts",
    "./hub/auth/password": "./hub/auth/password.ts",
    "./hub/auth/signup": "./hub/auth/signup.ts",
    "./hub/auth/totp": "./hub/auth/totp.ts",
    "./hub/auth/types": "./hub/auth/types.ts",
    "./hub/types": "./hub/types.ts",
    "./hub/users/profile": "./hub/users/profile.ts",
    "./problem/admin/authentication": "./problem/admin/authentication.ts",
    "./problem/admin/authorization": "./problem/admin/authorization.ts",
    "./problem/admin/hub-signup-domains": "./problem/admin/hub-signup-domains.ts",
    "./problem/admin/totp": "./problem/admin/totp.ts",
    "./problem/admin/users": "./problem/admin/users.ts",
    "./problem/common": "./problem/common.ts",
    "./problem/details": "./problem/details.ts",
    "./problem/global-coordinator/authentication": "./problem/global-coordinator/authentication.ts"
    ,"./problem/hub/authentication": "./problem/hub/authentication.ts"
    ,"./problem/hub/signup": "./problem/hub/signup.ts"
    ,"./problem/hub/totp": "./problem/hub/totp.ts"
  },
  "files": [
    "admin/**/*.ts",
    "common/**/*.ts",
    "global-coordinator/**/*.ts",
    "hub/**/*.ts",
    "problem/**/*.ts",
    "!**/*.test.ts"
  ],
  "scripts": {
    "check:contract-files": "node scripts/check-contract-files.mjs",
    "compile": "tsp compile .",
    "format": "biome check --write --config-path=../biome.json .",
    "format:check": "biome check --config-path=../biome.json .",
    "test:ts": "node --experimental-strip-types --test admin/*.test.ts common/*.test.ts global-coordinator/*.test.ts hub/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typespec/compiler": "latest",
    "@typespec/http": "latest",
    "@typespec/rest": "latest",
    "@typespec/openapi": "latest",
    "@typespec/openapi3": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943"
}
