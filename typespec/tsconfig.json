{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "admin/**/*.ts",
    "common/**/*.ts",
    "directory/**/*.ts",
    "problem/**/*.ts",
    "hub/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "tsp-output"]
}
