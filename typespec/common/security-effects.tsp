namespace Vetchium;

/** Closed vocabulary for machine-readable credential and privilege effects. */
enum SecurityEffect {
  CreateLoginChallenge: "create-login-challenge",
  ConsumeLoginChallenge: "consume-login-challenge",
  InvalidateLoginChallenges: "invalidate-login-challenges",
  RejectTOTPReplay: "reject-totp-replay",
  CreateTOTPEnrollment: "create-totp-enrollment",
  ConsumeTOTPEnrollment: "consume-totp-enrollment",
  InvalidateTOTPEnrollments: "invalidate-totp-enrollments",
  EnableTOTP: "enable-totp",
  DisableTOTP: "disable-totp",
  GenerateRecoveryCodes: "generate-recovery-codes",
  ConsumeRecoveryCode: "consume-recovery-code",
  InvalidateRecoveryCodes: "invalidate-recovery-codes",
  RotatePassword: "rotate-password",
  CreatePasswordResetToken: "create-password-reset-token",
  InvalidatePasswordResetTokens: "invalidate-password-reset-tokens",
  QueuePasswordResetEmail: "queue-password-reset-email",
  CreateAdminInvitation: "create-admin-invitation",
  ConsumeAdminInvitation: "consume-admin-invitation",
  QueueAdminInvitationEmail: "queue-admin-invitation-email",
  CreateAdminUser: "create-admin-user",
  RevokeOtherSessions: "revoke-other-sessions",
  RevokeAllSessions: "revoke-all-sessions",
  DisableAdminUser: "disable-admin-user",
  EnableAdminUser: "enable-admin-user",
  GrantAdminPermission: "grant-admin-permission",
  RevokeAdminPermission: "revoke-admin-permission",
  ClearDirectPermissions: "clear-direct-permissions",
  PromoteToSuperadmin: "promote-to-superadmin",
  DemoteFromSuperadmin: "demote-from-superadmin",
}
