{
  "http": {
    "routers": {
      "api-hub": {
        "rule": "Host(`sgp.api.vetchium.localhost`) && PathPrefix(`/api/hub/`)",
        "service": "hub-api",
        "middlewares": ["cors-hub"],
        "entryPoints": ["web"]
      },
      "api-orgs": {
        "rule": "Host(`sgp.api.vetchium.localhost`) && PathPrefix(`/api/orgs/`)",
        "service": "orgs-api",
        "middlewares": ["cors-orgs"],
        "entryPoints": ["web"]
      },
      "media": {
        "rule": "Host(`media.sgp.localhost`) && (Method(`GET`) || Method(`HEAD`)) && PathRegexp(`^/hub-profile-pictures/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)",
        "service": "media",
        "entryPoints": ["web"],
        "priority": 100
      },
      "orgs-api": {
        "rule": "Host(`orgs-ui.sgp.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "orgs-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "orgs-ui": {
        "rule": "Host(`orgs-ui.sgp.localhost`)",
        "service": "orgs-ui",
        "entryPoints": ["web"]
      },
      "hub-api": {
        "rule": "Host(`hub-ui.sgp.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "hub-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "hub-ui": {
        "rule": "Host(`hub-ui.sgp.localhost`)",
        "service": "hub-ui",
        "entryPoints": ["web"]
      },
      "admin-api": {
        "rule": "Host(`admin-ui.sgp.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "admin-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "admin-ui": {
        "rule": "Host(`admin-ui.sgp.localhost`)",
        "service": "admin-ui",
        "entryPoints": ["web"]
      }
    },
    "middlewares": {
      "cors-hub": {
        "headers": {
          "accessControlAllowOriginList": ["http://vetchium.localhost"],
          "accessControlAllowMethods": ["GET", "POST"],
          "accessControlAllowHeaders": [
            "Authorization",
            "Content-Type",
            "Idempotency-Key"
          ],
          "accessControlMaxAge": 86400,
          "addVaryHeader": true
        }
      },
      "cors-orgs": {
        "headers": {
          "accessControlAllowOriginList": ["http://orgs.vetchium.localhost"],
          "accessControlAllowMethods": ["GET", "POST"],
          "accessControlAllowHeaders": [
            "Authorization",
            "Content-Type",
            "Idempotency-Key"
          ],
          "accessControlMaxAge": 86400,
          "addVaryHeader": true
        }
      }
    },
    "services": {
      "media": {
        "loadBalancer": {
          "servers": [{ "url": "http://media-proxy-sgp:8080" }],
          "passHostHeader": true
        }
      },
      "orgs-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-api-sgp:8080"
            }
          ]
        }
      },
      "hub-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-api-sgp:8080"
            }
          ]
        }
      },
      "admin-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-api-sgp:8080"
            }
          ]
        }
      },
      "orgs-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-ui-sgp:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "hub-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-ui-sgp:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "admin-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-ui-sgp:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      }
    }
  }
}
