{
  "http": {
    "routers": {
      "orgs-api": {
        "rule": "Host(`orgs-ui.usa1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "orgs-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "orgs-ui": {
        "rule": "Host(`orgs-ui.usa1.localhost`)",
        "service": "orgs-ui",
        "entryPoints": ["web"]
      },
      "hub-api": {
        "rule": "Host(`hub-ui.usa1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "hub-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "hub-ui": {
        "rule": "Host(`hub-ui.usa1.localhost`)",
        "service": "hub-ui",
        "entryPoints": ["web"]
      },
      "admin-api": {
        "rule": "Host(`admin-ui.usa1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "admin-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "admin-ui": {
        "rule": "Host(`admin-ui.usa1.localhost`)",
        "service": "admin-ui",
        "entryPoints": ["web"]
      }
    },
    "services": {
      "orgs-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-api-usa1:8080"
            }
          ]
        }
      },
      "hub-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-api-usa1:8080"
            }
          ]
        }
      },
      "admin-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-api-usa1:8080"
            }
          ]
        }
      },
      "orgs-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-ui-usa1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "hub-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-ui-usa1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "admin-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-ui-usa1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      }
    }
  }
}
