{
  "http": {
    "routers": {
      "hub-ui": {
        "rule": "Host(`vetchium.localhost`)",
        "service": "hub-ui",
        "entryPoints": ["web"]
      },
      "orgs-ui": {
        "rule": "Host(`orgs.vetchium.localhost`)",
        "service": "orgs-ui",
        "entryPoints": ["web"]
      },
      "oidc-dev": {
        "rule": "Host(`oidc.vetchium.localhost`)",
        "service": "oidc-dev",
        "entryPoints": ["web"]
      },
      "sgp-api": {
        "rule": "Host(`sgp.api.vetchium.localhost`)",
        "service": "sgp",
        "entryPoints": ["web"]
      },
      "usa1-api": {
        "rule": "Host(`usa1.api.vetchium.localhost`)",
        "service": "usa1",
        "entryPoints": ["web"]
      },
      "deu-api": {
        "rule": "Host(`deu.api.vetchium.localhost`)",
        "service": "deu",
        "entryPoints": ["web"]
      },
      "ind1-api": {
        "rule": "Host(`ind1.api.vetchium.localhost`)",
        "service": "ind1",
        "entryPoints": ["web"]
      },
      "sgp": {
        "rule": "HostRegexp(`^[a-z-]+\\.sgp\\.[a-z0-9.-]+$`)",
        "service": "sgp",
        "entryPoints": ["web"]
      },
      "usa1": {
        "rule": "HostRegexp(`^[a-z-]+\\.usa1\\.[a-z0-9.-]+$`)",
        "service": "usa1",
        "entryPoints": ["web"]
      },
      "deu": {
        "rule": "HostRegexp(`^[a-z-]+\\.deu\\.[a-z0-9.-]+$`)",
        "service": "deu",
        "entryPoints": ["web"]
      },
      "ind1": {
        "rule": "HostRegexp(`^[a-z-]+\\.ind1\\.[a-z0-9.-]+$`)",
        "service": "ind1",
        "entryPoints": ["web"]
      }
    },
    "services": {
      "oidc-dev": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://oidc-dev:8080"
            }
          ]
        }
      },
      "hub-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-ui:8080"
            }
          ]
        }
      },
      "orgs-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-ui:8080"
            }
          ]
        }
      },
      "sgp": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://traefik-sgp:80"
            }
          ],
          "passHostHeader": true
        }
      },
      "usa1": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://traefik-usa1:80"
            }
          ],
          "passHostHeader": true
        }
      },
      "deu": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://traefik-deu:80"
            }
          ],
          "passHostHeader": true
        }
      },
      "ind1": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://traefik-ind1:80"
            }
          ],
          "passHostHeader": true
        }
      }
    }
  }
}
