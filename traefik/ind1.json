{
  "http": {
    "routers": {
      "media": {
        "rule": "Host(`media.ind1.localhost`) && (Method(`GET`) || Method(`HEAD`)) && PathRegexp(`^/hub-profile-pictures/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)",
        "service": "media",
        "entryPoints": ["web"],
        "priority": 100
      },
      "orgs-api": {
        "rule": "Host(`orgs-ui.ind1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "orgs-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "orgs-ui": {
        "rule": "Host(`orgs-ui.ind1.localhost`)",
        "service": "orgs-ui",
        "entryPoints": ["web"]
      },
      "hub-api": {
        "rule": "Host(`hub-ui.ind1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "hub-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "hub-ui": {
        "rule": "Host(`hub-ui.ind1.localhost`)",
        "service": "hub-ui",
        "entryPoints": ["web"]
      },
      "admin-api": {
        "rule": "Host(`admin-ui.ind1.localhost`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "admin-api",
        "entryPoints": ["web"],
        "priority": 100
      },
      "admin-ui": {
        "rule": "Host(`admin-ui.ind1.localhost`)",
        "service": "admin-ui",
        "entryPoints": ["web"]
      }
    },
    "services": {
      "media": {
        "loadBalancer": {
          "servers": [{ "url": "http://media-proxy-ind1:8080" }],
          "passHostHeader": true
        }
      },
      "orgs-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-api-ind1:8080"
            }
          ]
        }
      },
      "hub-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-api-ind1:8080"
            }
          ]
        }
      },
      "admin-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-api-ind1:8080"
            }
          ]
        }
      },
      "orgs-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-ui-ind1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "hub-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-ui-ind1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      },
      "admin-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-ui-ind1:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      }
    }
  }
}
