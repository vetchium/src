{
  "tenantId": "ind1",
  "env": "ci",
  "database": {
    "host": "db-ind1",
    "port": 5432,
    "user": "vetchium_app",
    "name": "tenant_db",
    "passwordFile": "/run/secrets/app_postgres_password",
    "sslMode": "disable"
  },
  "workers": {
    "retryBackoffLimit": "10s",
    "pruneAdminSessionsTimer": "10s",
    "pruneEphemeralDataTimer": "10s",
    "deliverHubEmailTimer": "250ms",
    "hubEmailLeaseTTL": "10s",
    "hubEmailMaxAttempts": 5,
    "advanceHubSubscriptionsTimer": "1s",
    "expireOrgOpeningsTimer": "1s",
    "reconcileHubSignupTimer": "1s",
    "reconcileHubEmailChangeTimer": "1s",
    "deliverOrgEmailTimer": "250ms",
    "orgEmailLeaseTTL": "10s",
    "orgEmailMaxAttempts": 5,
    "reconcileOrgSignupTimer": "1s",
    "verifyOrgDomainsTimer": "1s"
  },
  "adminAPIServer": {
    "sessionTTL": "30s"
  },
  "globalCoordinator": {
    "baseURL": "https://127.0.0.1:1",
    "requestTimeout": "5s",
    "tls": {
      "certificateFile": "/run/secrets/mesh_client_certificate",
      "keyFile": "/run/secrets/mesh_client_key",
      "caFile": "/run/secrets/mesh_ca_certificate",
      "serverName": "global-coordinator.mesh.vetchium.com"
    }
  },
  "meshAPIServer": {
    "baseURL": "http://mesh-api-ind1:8080",
    "credentialFile": "/run/secrets/mesh_credential",
    "requestTimeout": "5s",
    "peerAddress": "10.242.0.14:8443",
    "peerTLS": {
      "certificateFile": "/run/secrets/mesh_server_certificate",
      "keyFile": "/run/secrets/mesh_server_key",
      "clientCAFile": "/run/secrets/mesh_ca_certificate"
    }
  },
  "hubAPIServer": {
    "sessionTTL": "24h",
    "rememberedSessionTTL": "6360h",
    "publicBaseURL": "http://vetchium.localhost",
    "signup": {
      "enabled": true
    },
    "offeredPlans": ["hub-free-tier", "hub-silver-tier"]
  },
  "objectStorage": {
    "privateBaseURL": "http://seaweed-s3-ind1:8333",
    "mediaBaseURL": "http://media.ind1.localhost",
    "accessKeyFile": "/run/secrets/seaweed_s3_access_key",
    "secretKeyFile": "/run/secrets/seaweed_s3_secret_key"
  },
  "smtp": {
    "host": "mailpit",
    "port": 1025,
    "fromAddress": "no-reply@vetchium.local",
    "fromName": "Vetchium",
    "usernameFile": "",
    "passwordFile": "",
    "startTLS": "disabled",
    "connectionTimeout": "5s"
  },
  "orgsAPIServer": {
    "sessionTTL": "30s",
    "signupTTL": "168h",
    "invitationTTL": "168h",
    "publicBaseURL": "http://orgs.vetchium.localhost",
    "googleSignIn": {
      "issuer": "http://oidc.vetchium.localhost",
      "discoveryURL": "http://oidc-dev:8080",
      "clientID": "vetchium-dev.apps.googleusercontent.com",
      "clientSecretFile": "/run/secrets/google_oidc_client_secret",
      "redirectURI": "http://orgs.vetchium.localhost/sso/google/callback"
    },
    "signup": {
      "enabled": true
    },
    "allowSpecialUseDomains": true
  },
  "orgDomainVerification": {
    "resolverAddress": "dns-dev:53",
    "trustReservedDomains": true,
    "lookupTimeout": "2s",
    "checkInterval": "2s",
    "failureThreshold": 2,
    "failingGracePeriod": "8s",
    "inconclusiveRetry": "1s",
    "inconclusiveLimit": "30s"
  },
  "orgBilling": {
    "offeredPlans": ["org-free-tier", "org-silver-tier", "org-gold-tier"]
  },
  "mcpServer": {},
  "ai": {
    "requestTimeout": "3s",
    "reservationTimeout": "10s",
    "textRetention": "4320h",
    "grantCreditsInterval": "1s",
    "releaseReservationsInterval": "1s",
    "models": [
      {
        "oid": "qwen3-1-7b",
        "displayName": "Qwen3 1.7B",
        "vendor": "Alibaba Cloud Qwen",
        "licence": "Apache-2.0",
        "baseURL": "http://ai-dev:8080/engines/v1",
        "hostModel": "ai/qwen3:1.7b",
        "jsonSchemaOutput": true,
        "chatTemplateKwargs": { "enable_thinking": false },
        "maxOutputTokens": 3072,
        "inputCreditsPerMillionTokens": 20000,
        "outputCreditsPerMillionTokens": 60000
      },
      {
        "oid": "ministral-3-3b",
        "displayName": "Ministral 3 3B",
        "vendor": "Mistral AI",
        "licence": "Apache-2.0",
        "baseURL": "http://ai-dev:8080/engines/v1",
        "hostModel": "ai/ministral3:3B-Q4_K_M",
        "jsonSchemaOutput": true,
        "maxOutputTokens": 3072,
        "inputCreditsPerMillionTokens": 30000,
        "outputCreditsPerMillionTokens": 80000
      }
    ],
    "operationDefaults": { "org-opening-draft": "qwen3-1-7b" },
    "creditPacks": [
      {
        "id": "credits-100k",
        "credits": 100000,
        "priceCurrency": "INR",
        "priceAmountMinor": 85000
      },
      {
        "id": "credits-500k",
        "credits": 500000,
        "priceCurrency": "INR",
        "priceAmountMinor": 380000
      }
    ]
  },
  "signupRegionsFile": "/etc/vetchium/signup-regions.json"
}
