{
  "tenantId": "ind1",
  "env": "ci",
  "database": {
    "host": "db-ind1",
    "port": 5432,
    "user": "vetchium_app",
    "name": "tenant_db",
    "passwordFile": "/run/secrets/app_postgres_password",
    "sslMode": "disable"
  },
  "workers": {
    "retryBackoffLimit": "10s",
    "pruneAdminSessionsTimer": "10s",
    "pruneEphemeralDataTimer": "10s",
    "deliverHubEmailTimer": "250ms",
    "hubEmailLeaseTTL": "10s",
    "hubEmailMaxAttempts": 5
  },
  "adminAPIServer": {
    "sessionTTL": "30s"
  },
  "globalCoordinator": {
    "baseURL": "http://127.0.0.1:1",
    "credentialFile": "/run/secrets/global_coordinator_credential",
    "requestTimeout": "5s"
  },
  "meshAPIServer": {
    "baseURL": "http://mesh-api-ind1:8080",
    "credentialFile": "/run/secrets/mesh_credential",
    "requestTimeout": "5s"
  },
  "hubAPIServer": {
    "sessionTTL": "24h",
    "rememberedSessionTTL": "6360h",
    "publicBaseURL": "http://hub-ui.ind1.localhost",
    "signup": {
      "enabled": true
    }
  },
  "smtp": {
    "host": "mailpit",
    "port": 1025,
    "fromAddress": "no-reply@vetchium.local",
    "fromName": "Vetchium",
    "usernameFile": "",
    "passwordFile": "",
    "startTLS": "disabled",
    "connectionTimeout": "5s"
  },
  "orgsAPIServer": {},
  "mcpServer": {},
  "signupRegionsFile": "/etc/vetchium/signup-regions.json"
}
