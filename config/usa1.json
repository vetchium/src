{
  "tenantId": "usa1",
  "env": "dev",
  "database": {
    "host": "db-usa1",
    "port": 5432,
    "user": "vetchium_app",
    "name": "tenant_db",
    "passwordFile": "/run/secrets/app_postgres_password",
    "sslMode": "disable"
  },
  "workers": {
    "retryBackoffLimit": "5m",
    "pruneAdminSessionsTimer": "5m",
    "pruneEphemeralDataTimer": "5m",
    "deliverHubEmailTimer": "500ms",
    "hubEmailLeaseTTL": "1m",
    "hubEmailMaxAttempts": 5,
    "advanceHubSubscriptionsTimer": "1m",
    "reconcileHubSignupTimer": "10s",
    "reconcileHubEmailChangeTimer": "10s",
    "deliverOrgEmailTimer": "500ms",
    "orgEmailLeaseTTL": "1m",
    "orgEmailMaxAttempts": 5,
    "reconcileOrgSignupTimer": "10s",
    "verifyOrgDomainsTimer": "30s"
  },
  "adminAPIServer": {
    "sessionTTL": "24h"
  },
  "globalCoordinator": {
    "baseURL": "https://global-coordinator:8080",
    "requestTimeout": "5s",
    "tls": {
      "certificateFile": "/run/secrets/mesh_client_certificate",
      "keyFile": "/run/secrets/mesh_client_key",
      "caFile": "/run/secrets/mesh_ca_certificate",
      "serverName": "global-coordinator.mesh.vetchium.com"
    }
  },
  "meshAPIServer": {
    "baseURL": "http://mesh-api-usa1:8080",
    "credentialFile": "/run/secrets/mesh_credential",
    "requestTimeout": "5s",
    "peerAddress": "10.242.0.12:8443",
    "peerTLS": {
      "certificateFile": "/run/secrets/mesh_server_certificate",
      "keyFile": "/run/secrets/mesh_server_key",
      "clientCAFile": "/run/secrets/mesh_ca_certificate"
    }
  },
  "hubAPIServer": {
    "sessionTTL": "24h",
    "rememberedSessionTTL": "6360h",
    "publicBaseURL": "http://vetchium.localhost",
    "signup": {
      "enabled": true
    },
    "offeredPlans": ["hub-free-tier", "hub-silver-tier"]
  },
  "objectStorage": {
    "privateBaseURL": "http://seaweed-s3-usa1:8333",
    "mediaBaseURL": "http://media.usa1.localhost",
    "accessKeyFile": "/run/secrets/seaweed_s3_access_key",
    "secretKeyFile": "/run/secrets/seaweed_s3_secret_key"
  },
  "smtp": {
    "host": "mailpit",
    "port": 1025,
    "fromAddress": "no-reply@vetchium.local",
    "fromName": "Vetchium",
    "usernameFile": "",
    "passwordFile": "",
    "startTLS": "disabled",
    "connectionTimeout": "5s"
  },
  "orgsAPIServer": {
    "sessionTTL": "24h",
    "signupTTL": "168h",
    "invitationTTL": "168h",
    "publicBaseURL": "http://orgs.vetchium.localhost",
    "googleSignIn": {
      "issuer": "http://oidc.vetchium.localhost",
      "discoveryURL": "http://oidc-dev:8080",
      "clientID": "vetchium-dev.apps.googleusercontent.com",
      "clientSecretFile": "/run/secrets/google_oidc_client_secret",
      "redirectURI": "http://orgs.vetchium.localhost/sso/google/callback"
    },
    "signup": {
      "enabled": true
    },
    "allowSpecialUseDomains": true
  },
  "orgDomainVerification": {
    "resolverAddress": "dns-dev:53",
    "trustReservedDomains": true,
    "lookupTimeout": "5s",
    "checkInterval": "10m",
    "failureThreshold": 2,
    "failingGracePeriod": "1h",
    "inconclusiveRetry": "1m",
    "inconclusiveLimit": "1h"
  },
  "orgBilling": {
    "offeredPlans": ["org-free-tier", "org-silver-tier", "org-gold-tier"]
  },
  "mcpServer": {},
  "signupRegionsFile": "/etc/vetchium/signup-regions.json"
}
