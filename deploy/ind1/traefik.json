{
  "http": {
    "routers": {
      "api-hub": {
        "rule": "Host(`ind1.api.vetchium.com`) && PathPrefix(`/api/hub/`)",
        "service": "hub-api",
        "middlewares": ["cors-hub"],
        "entryPoints": ["websecure"]
      },
      "api-orgs": {
        "rule": "Host(`ind1.api.vetchium.com`) && PathPrefix(`/api/orgs/`)",
        "service": "orgs-api",
        "middlewares": ["cors-orgs"],
        "entryPoints": ["websecure"]
      },
      "media": {
        "rule": "Host(`media.ind1.vetchium.com`) && (Method(`GET`) || Method(`HEAD`)) && PathRegexp(`^/hub-profile-pictures/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)",
        "service": "media",
        "entryPoints": ["websecure"],
        "priority": 100
      },
      "admin-api": {
        "rule": "Host(`admin.ind1.vetchium.com`) && (Path(`/api`) || PathPrefix(`/api/`))",
        "service": "admin-api",
        "entryPoints": ["websecure"],
        "priority": 100
      },
      "admin-ui": {
        "rule": "Host(`admin.ind1.vetchium.com`)",
        "service": "admin-ui",
        "entryPoints": ["websecure"]
      }
    },
    "middlewares": {
      "cors-hub": {
        "headers": {
          "accessControlAllowOriginList": ["https://vetchium.com"],
          "accessControlAllowMethods": ["GET", "POST"],
          "accessControlAllowHeaders": [
            "Authorization",
            "Content-Type",
            "Idempotency-Key"
          ],
          "accessControlMaxAge": 86400,
          "addVaryHeader": true
        }
      },
      "cors-orgs": {
        "headers": {
          "accessControlAllowOriginList": ["https://orgs.vetchium.com"],
          "accessControlAllowMethods": ["GET", "POST"],
          "accessControlAllowHeaders": [
            "Authorization",
            "Content-Type",
            "Idempotency-Key"
          ],
          "accessControlMaxAge": 86400,
          "addVaryHeader": true
        }
      }
    },
    "services": {
      "media": {
        "loadBalancer": {
          "servers": [{ "url": "http://media-proxy:8080" }],
          "passHostHeader": true
        }
      },
      "orgs-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://orgs-api:8080"
            }
          ]
        }
      },
      "hub-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://hub-api:8080"
            }
          ]
        }
      },
      "admin-api": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-api:8080"
            }
          ]
        }
      },
      "admin-ui": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://admin-ui:8080"
            }
          ],
          "healthCheck": {
            "path": "/healthz",
            "interval": "10s",
            "timeout": "3s"
          }
        }
      }
    }
  }
}
