# Copy to .env on the server. Not read by git.

REGISTRY=ghcr.io/vetchium
POSTGRES_USER=pguser
POSTGRES_DB=tenant_db
# PostgreSQL transport mode for applications and migrations.
PGSSLMODE=disable
# The port Traefik publishes on the host. Change if something else has 80.
HTTP_PORT=80
# Default Admin UI locale before a user signs in: en-US, ta, or de_DE.
ADMIN_UI_DEFAULT_LANGUAGE=en-US
