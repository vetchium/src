# Copy to .env on the server. Not read by git.

REGISTRY=ghcr.io/vetchium
POSTGRES_USER=pguser
POSTGRES_DB=tenant_db
GLOBAL_POSTGRES_USER=global_admin
GLOBAL_POSTGRES_DB=global_db
# PostgreSQL transport mode for applications and migrations.
PGSSLMODE=disable
# The port Traefik publishes on the host. Change if something else has 80.
HTTP_PORT=80
# Port published by this tenant's mutually authenticated mesh API.
MESH_API_PORT=8443
# Port published by the separately deployed global coordinator.
GLOBAL_COORDINATOR_PORT=8080
# The coordinator's private WireGuard address. On a coordinator host this
# address must belong to WIREGUARD_INTERFACE; on a tenant host the route and
# global-coordinator.internal DNS record must both select it.
GLOBAL_COORDINATOR_WIREGUARD_IP=10.120.0.1
# This tenant host's private WireGuard address. REGION.mesh.vetchium.com must
# resolve to this address only inside the private mesh.
MESH_API_WIREGUARD_IP=10.120.0.2
WIREGUARD_INTERFACE=wg0
# Version these names during certificate rotation. Tenant deployments default
# the client names to <region>_mesh_client_certificate and
# <region>_mesh_client_key when these two entries are left unset.
MESH_CA_SECRET_NAME=vetchium_mesh_ca_certificate
GLOBAL_COORDINATOR_TLS_CERTIFICATE_SECRET_NAME=global_coordinator_tls_certificate
GLOBAL_COORDINATOR_TLS_KEY_SECRET_NAME=global_coordinator_tls_key
GLOBAL_COORDINATOR_HEALTH_CERTIFICATE_SECRET_NAME=global_coordinator_health_certificate
GLOBAL_COORDINATOR_HEALTH_KEY_SECRET_NAME=global_coordinator_health_key
# MESH_CLIENT_CERTIFICATE_SECRET_NAME=sgp_mesh_client_certificate
# MESH_CLIENT_KEY_SECRET_NAME=sgp_mesh_client_key
# MESH_SERVER_CERTIFICATE_SECRET_NAME=sgp_mesh_server_certificate
# MESH_SERVER_KEY_SECRET_NAME=sgp_mesh_server_key
# Default Admin UI locale before a user signs in: en-US, ta, or de_DE.
ADMIN_UI_DEFAULT_LANGUAGE=en-US
