{
  "tenantId": "sgp",
  "env": "production",
  "database": {
    "host": "db",
    "port": 5432,
    "user": "vetchium_app",
    "name": "tenant_db",
    "passwordFile": "/run/secrets/app_postgres_password",
    "sslMode": "disable"
  },
  "workers": {
    "retryBackoffLimit": "5m",
    "pruneAdminSessionsTimer": "5m",
    "pruneEphemeralDataTimer": "5m",
    "deliverHubEmailTimer": "5s",
    "hubEmailLeaseTTL": "1m",
    "hubEmailMaxAttempts": 5
  },
  "adminAPIServer": {
    "sessionTTL": "24h"
  },
  "globalCoordinator": {
    "baseURL": "http://global-coordinator.internal:8080",
    "credentialFile": "/run/secrets/global_coordinator_credential",
    "requestTimeout": "5s"
  },
  "hubAPIServer": {
    "sessionTTL": "24h",
    "rememberedSessionTTL": "6360h",
    "publicBaseURL": "https://hub.sgp.vetchium.com"
  },
  "smtp": {
    "host": "smtp.vetchium.com",
    "port": 587,
    "fromAddress": "no-reply@vetchium.com",
    "fromName": "Vetchium",
    "usernameFile": "/run/secrets/smtp_username",
    "passwordFile": "/run/secrets/smtp_password",
    "startTLS": "required",
    "connectionTimeout": "10s"
  },
  "orgsAPIServer": {},
  "mcpServer": {}
}
