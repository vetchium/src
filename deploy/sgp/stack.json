    "seaweed-master": {
      "image": "ghcr.io/chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882",
      "networks": ["backend"],
      "security_opt": ["no-new-privileges:true"],
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "stop-first",
          "failure_action": "pause",
          "parallelism": 1
        },
        "restart_policy": {
          "condition": "any",
          "delay": "10s"
        },
        "resources": {
          "limits": {
            "memory": "512M"
          },
          "reservations": {
            "memory": "128M"
          }
        }
      },
      "command": [
        "master",
        "-ip=seaweed-master",
        "-ip.bind=0.0.0.0",
        "-port=9333",
        "-mdir=/data",
        "-volumeSizeLimitMB=1024"
      ],
      "volumes": ["seaweed-masterdata:/data"],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:9333/cluster/status >/dev/null"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    "seaweed-volume": {
      "image": "ghcr.io/chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882",
