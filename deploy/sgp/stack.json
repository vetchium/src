      "read_only": true,
      "configs": [
        {
          "source": "app_config",
          "target": "/etc/vetchium/config.json"
        }
      ],
      "environment": {
        "PGDATABASE": "${POSTGRES_DB:?set POSTGRES_DB}",
        "PGSSLMODE": "${PGSSLMODE:-disable}"
      },
      "secrets": ["app_postgres_password", "admin_credential_key"],
      "image": "${REGISTRY:-ghcr.io/vetchium}/admin-api:${TAG:?set TAG}",
      "networks": ["admin_api_access", "backend"]
    },
