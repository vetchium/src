        }
      },
      "command": [
        "filer",
        "-ip=seaweed-filer",
        "-ip.bind=0.0.0.0",
        "-port=8888",
        "-master=seaweed-master:9333",
        "-defaultStoreDir=/data"
      ],
      "volumes": ["seaweed-filerdata:/data"],
      "healthcheck": {
        "test": ["CMD-SHELL", "curl -fsS http://127.0.0.1:8888/ >/dev/null"],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    "seaweed-s3": {
      "image": "ghcr.io/chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882",
      "networks": ["backend"],
      "security_opt": ["no-new-privileges:true"],
      "deploy": {
        "replicas": 1,
