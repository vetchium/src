    "media_proxy": {
      "file": "../../media/nginx.conf",
      "name": "sgp-media-proxy-${MEDIA_PROXY_HASH:?run via make}"
    },
    "seaweed_s3_entrypoint": {
      "file": "../../dev/seaweedfs-s3-entrypoint.sh",
      "name": "sgp-seaweed-s3-entrypoint-${SEAWEED_S3_ENTRYPOINT_HASH:?run via make}"
    },
