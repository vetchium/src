        "-ip.bind=0.0.0.0",
        "-port=8080",
        "-dir=/data",
        "-master=seaweed-master:9333"
      ],
      "volumes": ["seaweed-volumedata:/data"],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
