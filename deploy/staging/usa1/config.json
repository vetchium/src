{
  "signupRegionsFile": "/etc/vetchium/signup-regions.json",
  "tenantId": "usa1",
  "env": "staging",
  "database": {
    "host": "db",
    "port": 5432,
    "user": "vetchium_app",
    "name": "tenant_db",
    "passwordFile": "/run/secrets/app_postgres_password",
    "sslMode": "disable"
  },
  "workers": {
    "retryBackoffLimit": "5m",
    "pruneAdminSessionsTimer": "5m",
    "pruneEphemeralDataTimer": "5m",
    "deliverHubEmailTimer": "5s",
    "hubEmailLeaseTTL": "1m",
    "hubEmailMaxAttempts": 5,
    "advanceHubSubscriptionsTimer": "1m",
    "expireOrgOpeningsTimer": "5m",
    "expireOrgEngagementsTimer": "5m",
    "expireApplicationOffersTimer": "5m",
    "retainApplicationsTimer": "1h",
    "retainOrgContactsTimer": "1h",
    "refreshHubApplicationsTimer": "5m",
    "reconcileHubSignupTimer": "10s",
    "reconcileHubEmailChangeTimer": "10s",
    "driveFederationCommandsTimer": "10s",
    "deliverFederationEventsTimer": "5s",
    "deliverOrgEmailTimer": "5s",
    "orgEmailLeaseTTL": "1m",
    "orgEmailMaxAttempts": 5,
    "reconcileOrgSignupTimer": "10s",
    "verifyOrgDomainsTimer": "5m"
  },
  "adminAPIServer": {
    "sessionTTL": "24h"
  },
  "globalCoordinator": {
    "baseURL": "https://global-coordinator:8080",
    "requestTimeout": "5s",
    "tls": {
      "certificateFile": "/run/secrets/mesh_client_certificate",
      "keyFile": "/run/secrets/mesh_client_key",
      "caFile": "/run/secrets/mesh_ca_certificate",
      "serverName": "global-coordinator.mesh.vetchium.com"
    }
  },
  "meshAPIServer": {
    "baseURL": "http://mesh-api:8080",
    "credentialFile": "/run/secrets/mesh_credential",
    "requestTimeout": "5s",
    "peerAddress": "10.242.0.12:8443",
    "peerTLS": {
      "certificateFile": "/run/secrets/mesh_server_certificate",
      "keyFile": "/run/secrets/mesh_server_key",
      "clientCAFile": "/run/secrets/mesh_ca_certificate"
    }
  },
  "hubAPIServer": {
    "sessionTTL": "24h",
    "rememberedSessionTTL": "6360h",
    "publicBaseURL": "https://vetchium.com",
    "offeredPlans": ["hub-free-tier", "hub-silver-tier"]
  },
  "objectStorage": {
    "privateBaseURL": "http://seaweed-s3:8333",
    "mediaBaseURL": "https://usa1-media.vetchium.com",
    "accessKeyFile": "/run/secrets/seaweed_s3_access_key",
    "secretKeyFile": "/run/secrets/seaweed_s3_secret_key"
  },
  "smtp": {
    "host": "mailpit",
    "port": 1025,
    "fromAddress": "no-reply@vetchium.com",
    "fromName": "Vetchium",
    "usernameFile": "",
    "passwordFile": "",
    "startTLS": "disabled",
    "connectionTimeout": "10s"
  },
  "orgsAPIServer": {
    "sessionTTL": "24h",
    "signupTTL": "168h",
    "invitationTTL": "168h",
    "publicBaseURL": "https://orgs.vetchium.com",
    "allowSpecialUseDomains": true
  },
  "orgDomainVerification": {
    "resolverAddress": "1.1.1.1:53",
    "trustReservedDomains": true,
    "lookupTimeout": "5s",
    "checkInterval": "168h",
    "failureThreshold": 2,
    "failingGracePeriod": "720h",
    "inconclusiveRetry": "1h",
    "inconclusiveLimit": "168h"
  },
  "orgBilling": {
    "offeredPlans": ["org-free-tier", "org-silver-tier", "org-gold-tier"]
  },
  "ai": {
    "requestTimeout": "120s",
    "reservationTimeout": "10m",
    "textRetention": "4320h",
    "grantCreditsInterval": "5m",
    "releaseReservationsInterval": "5m",
    "models": [
      {
        "oid": "qwen3-1-7b",
        "displayName": "Qwen3 1.7B",
        "vendor": "Alibaba Cloud Qwen",
        "licence": "Apache-2.0",
        "baseURL": "http://model-runner.docker.internal/engines/v1",
        "hostModel": "ai/qwen3:1.7b",
        "jsonSchemaOutput": true,
        "chatTemplateKwargs": {
          "enable_thinking": false
        },
        "maxOutputTokens": 3072,
        "inputCreditsPerMillionTokens": 20000,
        "outputCreditsPerMillionTokens": 60000
      },
      {
        "oid": "ministral-3-3b",
        "displayName": "Ministral 3 3B",
        "vendor": "Mistral AI",
        "licence": "Apache-2.0",
        "baseURL": "http://model-runner.docker.internal/engines/v1",
        "hostModel": "ai/ministral3:3B-Q4_K_M",
        "jsonSchemaOutput": true,
        "maxOutputTokens": 3072,
        "inputCreditsPerMillionTokens": 30000,
        "outputCreditsPerMillionTokens": 80000
      }
    ],
    "operationDefaults": {
      "org-opening-draft": "qwen3-1-7b"
    },
    "creditPacks": [
      {
        "id": "credits-100k",
        "credits": 100000,
        "priceCurrency": "USD",
        "priceAmountMinor": 1000
      },
      {
        "id": "credits-500k",
        "credits": 500000,
        "priceCurrency": "USD",
        "priceAmountMinor": 4500
      }
    ]
  },
  "marketplace": {
    "deletedPartyConversationRetention": "8760h",
    "conversationWindow": "2160h"
  },
  "mcpServer": {}
}
