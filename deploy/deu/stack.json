  "networks": {
    "ingress": {
      "driver": "overlay"
    },
    "admin_api_access": {
      "driver": "overlay",
      "internal": true
    },
    "hub_api_access": {
      "driver": "overlay",
      "internal": true
    },
    "orgs_api_access": {
      "driver": "overlay",
      "internal": true
    },
    "mesh": {
      "driver": "overlay",
      "internal": true,
      "attachable": true
    },
    "mcp_access": {
      "driver": "overlay",
      "internal": true
    },
    "backend": {
      "driver": "overlay",
      "internal": true,
      "attachable": true
    }
  },
  "volumes": {
    "pgdata": {}
  },
  "configs": {
    "database_entrypoint": {
      "file": "../../db/bootstrap/entrypoint.sh"
    },
    "database_init_sql": {
      "file": "../../db/bootstrap/init.sql"
    },
    "app_config": {
      "file": "./config.json",
      "name": "deu-app-${APP_CONFIG_HASH:?run via make}"
    },
    "traefik": {
      "file": "./traefik.json",
      "name": "deu-traefik-${TRAEFIK_HASH:?run via make}"
    }
  },
  "secrets": {
    "postgres_password": {
      "external": true,
      "name": "deu_postgres_password"
    },
    "app_postgres_password": {
      "external": true,
      "name": "deu_app_postgres_password"
    },
    "admin_credential_key": {
      "external": true,
      "name": "deu_admin_credential_key"
    }
  }
}
