{
  "x-scaled-service": {
    "deploy": {
      "replicas": 1,
      "update_config": {
        "order": "start-first",
        "failure_action": "rollback",
        "parallelism": 1,
        "delay": "10s",
        "monitor": "30s"
      },
      "rollback_config": {
        "order": "start-first",
        "parallelism": 1
      },
      "restart_policy": {
        "condition": "any",
        "delay": "5s"
      },
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "64M"
        }
      }
    }
  },
  "x-backend": {
    "deploy": {
      "replicas": 1,
      "update_config": {
        "order": "start-first",
        "failure_action": "rollback",
        "parallelism": 1,
        "delay": "10s",
        "monitor": "30s"
      },
      "rollback_config": {
        "order": "start-first",
        "parallelism": 1
      },
      "restart_policy": {
        "condition": "any",
        "delay": "5s"
      },
      "resources": {
        "limits": {
          "memory": "256M"
        },
        "reservations": {
          "memory": "64M"
        }
      }
    },
    "read_only": true,
    "configs": [
      {
        "source": "app_config",
        "target": "/etc/vetchium/config.json"
      }
    ],
    "environment": {
      "PGDATABASE": "${POSTGRES_DB:?set POSTGRES_DB}",
      "PGSSLMODE": "${PGSSLMODE:-disable}"
    },
    "secrets": ["app_postgres_password"]
  },
  "services": {
    "traefik": {
      "image": "traefik:v3.4.1",
      "command": [
        "--providers.file.filename=/etc/traefik/dynamic.json",
        "--providers.file.watch=true",
        "--entrypoints.web.address=:80",
        "--ping=true",
        "--log.level=INFO",
        "--accesslog=true"
      ],
      "ports": [
        {
          "target": 80,
          "published": "${HTTP_PORT:-80}",
          "protocol": "tcp",
          "mode": "host"
        }
      ],
      "networks": [
        "ingress",
        "admin_api_access",
        "hub_api_access",
        "orgs_api_access",
        "mcp_access"
      ],
      "configs": [
        {
          "source": "traefik",
          "target": "/etc/traefik/dynamic.json"
        }
      ],
      "healthcheck": {
        "test": ["CMD", "traefik", "healthcheck", "--ping"],
        "interval": "10s",
        "timeout": "3s",
        "retries": 3,
        "start_period": "10s"
      },
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "stop-first",
          "failure_action": "rollback",
          "parallelism": 1
        },
        "rollback_config": {
          "order": "start-first",
          "parallelism": 1
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "256M"
          },
          "reservations": {
            "memory": "64M"
          }
        }
      }
    },
    "db": {
      "image": "postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94",
      "entrypoint": ["/bin/sh", "/usr/local/bin/vetchium-entrypoint.sh"],
      "command": ["postgres"],
      "environment": {
        "POSTGRES_DB": "${POSTGRES_DB:?set POSTGRES_DB}",
        "POSTGRES_USER": "${POSTGRES_USER:?set POSTGRES_USER}",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password",
        "APP_POSTGRES_PASSWORD_FILE": "/run/secrets/app_postgres_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256"
      },
      "secrets": ["postgres_password", "app_postgres_password"],
      "configs": [
        {
          "source": "database_entrypoint",
          "target": "/usr/local/bin/vetchium-entrypoint.sh",
          "mode": 292
        },
        {
          "source": "database_init_sql",
          "target": "/docker-entrypoint-initdb.d/10-vetchium.sql",
          "mode": 292
        }
      ],
      "networks": ["backend"],
      "volumes": ["pgdata:/var/lib/postgresql/data"],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -h 127.0.0.1 -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "30s"
      },
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "stop-first",
          "failure_action": "pause",
          "parallelism": 1
        },
        "restart_policy": {
          "condition": "any",
          "delay": "10s"
        },
        "resources": {
          "limits": {
            "memory": "1G"
          },
          "reservations": {
            "memory": "256M"
          }
        }
      }
    },
    "admin-api": {
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "start-first",
          "failure_action": "rollback",
          "parallelism": 1,
          "delay": "10s",
          "monitor": "30s"
        },
        "rollback_config": {
          "order": "start-first",
          "parallelism": 1
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "256M"
          },
          "reservations": {
            "memory": "64M"
          }
        }
      },
      "read_only": true,
      "configs": [{"source": "app_config", "target": "/etc/vetchium/config.json"}],
      "environment": {
        "PGDATABASE": "${POSTGRES_DB:?set POSTGRES_DB}",
        "PGSSLMODE": "${PGSSLMODE:-disable}"
      },
      "secrets": ["app_postgres_password", "admin_credential_key"],
      "image": "${REGISTRY:-ghcr.io/vetchium}/admin-api:${TAG:?set TAG}",
      "networks": ["admin_api_access", "backend"]
    },
    "hub-api": {
      "deploy": {
