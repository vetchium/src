      },
      "secrets": ["app_postgres_password"],
      "image": "${REGISTRY:-ghcr.io/vetchium}/mcp-server:${TAG:?set TAG}",
      "networks": ["mcp_access", "backend"]
    },
    "workers": {
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "stop-first",
          "failure_action": "rollback",
          "parallelism": 1
        },
        "rollback_config": {
