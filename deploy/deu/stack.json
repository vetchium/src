    "mcp-server": {
      "deploy": {
        "replicas": 1,
        "update_config": {
          "order": "start-first",
          "failure_action": "rollback",
          "parallelism": 1,
          "delay": "10s",
          "monitor": "30s"
        },
        "rollback_config": {
