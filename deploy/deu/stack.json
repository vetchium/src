        },
        "resources": {
          "limits": {
            "memory": "256M"
          },
          "reservations": {
            "memory": "64M"
          }
        }
      },
      "image": "${REGISTRY:-ghcr.io/vetchium}/orgs-ui:${TAG:?set TAG}",
      "read_only": true,
      "networks": ["ingress"],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--spider",
          "-q",
          "http://127.0.0.1:8080/healthz"
        ],
        "interval": "10s",
        "timeout": "3s",
