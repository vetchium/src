    "db-deu": {
      "command": ["postgres"],
      "entrypoint": ["/bin/sh", "/usr/local/bin/vetchium-entrypoint.sh"],
      "environment": {
        "APP_POSTGRES_PASSWORD_FILE": "/run/secrets/app_postgres_password",
        "POSTGRES_DB": "${POSTGRES_DB:-tenant_db}",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-pgpassword}",
        "POSTGRES_USER": "${POSTGRES_USER:-pguser}"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "start_period": "10s",
        "test": [
          "CMD-SHELL",
          "pg_isready -h 127.0.0.1 -U $${POSTGRES_USER} -d $${POSTGRES_DB}"
        ],
        "timeout": "3s"
      },
      "image": "postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94",
      "networks": {
        "deu_backend": null
      },
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "app_postgres_password",
          "target": "/run/secrets/app_postgres_password"
        }
      ],
      "security_opt": ["no-new-privileges:true"],
      "volumes": [
        {
          "source": "pgdata-deu",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./db/bootstrap/entrypoint.sh",
          "target": "/usr/local/bin/vetchium-entrypoint.sh",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./db/bootstrap/init.sql",
          "target": "/docker-entrypoint-initdb.d/10-vetchium.sql",
          "type": "bind"
        }
      ]
    },
