    "edge": {
      "command": [
        "--providers.file.filename=/etc/traefik/dynamic.json",
        "--providers.file.watch=true",
        "--entrypoints.web.address=:80",
        "--ping=true",
        "--log.level=INFO",
        "--accesslog=true"
      ],
      "depends_on": {
        "traefik-deu": {
          "condition": "service_healthy",
          "required": true
        },
        "traefik-ind1": {
          "condition": "service_healthy",
          "required": true
        },
        "traefik-sgp": {
          "condition": "service_healthy",
          "required": true
        },
        "traefik-usa1": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 3,
        "start_period": "5s",
        "test": ["CMD", "traefik", "healthcheck", "--ping"],
        "timeout": "3s"
      },
      "image": "traefik:v3.4.1",
      "networks": {
        "deu_ingress": null,
        "ind1_ingress": null,
        "sgp_ingress": null,
        "usa1_ingress": null
      },
      "ports": ["${EDGE_BIND:-127.0.0.1}:${EDGE_PORT:-80}:80"],
      "restart": "unless-stopped",
      "security_opt": ["no-new-privileges:true"],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./traefik/edge.json",
          "target": "/etc/traefik/dynamic.json",
          "type": "bind"
        }
      ]
    },
