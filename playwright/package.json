{
  "name": "vetchium-playwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "biome check --write --config-path=../biome.json .",
    "format:check": "biome check --config-path=../biome.json .",
    "coverage:api": "node --experimental-strip-types scripts/api-coverage-report.ts",
    "test": "playwright test --pass-with-no-tests",
    "test:api": "playwright test --project=api --pass-with-no-tests",
    "test:coverage-api": "node --experimental-strip-types --test scripts/api-coverage-report.test.ts",
    "test:ui": "playwright test --project=chromium --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typespec": "file:../typespec"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943"
}
