{
  "name": "vetchium-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "biome check --write --config-path=../biome.json .",
    "format:check": "biome check --config-path=../biome.json .",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vetchium/portal-ui": "file:../portal-ui",
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "5.101.4",
    "ajv": "8.20.0",
    "antd": "6.6.0",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "typespec": "file:../typespec"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
